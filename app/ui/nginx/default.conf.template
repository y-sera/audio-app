# Rendered by the nginx image's envsubst step; only variables defined in
# the environment (API_UPSTREAM) are replaced.
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;

    # Transcript API of the audio-app container (JSON + Server-Sent Events).
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
